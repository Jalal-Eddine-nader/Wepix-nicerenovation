---
const categories = [
  {
    id: 'bathroom',
    labelKey: 'portfolio.cat.bathroom',
    label: 'Bathroom & Toilet',
    cover: '/images/bathroom/bathroom-1.jpg',
    images: Array.from({ length: 17 }, (_, i) => `/images/bathroom/bathroom-${i + 1}.jpg`),
  },
  {
    id: 'kitchen',
    labelKey: 'portfolio.cat.kitchen',
    label: 'Kitchen Renovation',
    cover: '/images/kitchen/kitchen-1.jpg',
    images: Array.from({ length: 6 }, (_, i) => `/images/kitchen/kitchen-${i + 1}.jpg`),
  },
  {
    id: 'rooms',
    labelKey: 'portfolio.cat.rooms',
    label: 'Room Renovation',
    cover: '/images/rooms/rooms-1.jpg',
    images: Array.from({ length: 11 }, (_, i) => `/images/rooms/rooms-${i + 1}.jpg`),
  },
  {
    id: 'commercial',
    labelKey: 'portfolio.cat.commercial',
    label: 'Commercial Renovation',
    cover: '/images/commercial/commercial-1.jpg',
    images: Array.from({ length: 6 }, (_, i) => `/images/commercial/commercial-${i + 1}.jpg`),
  },
  {
    id: 'plafond',
    labelKey: 'portfolio.cat.plafond',
    label: 'Ceiling & Plastering',
    cover: '/images/plafond/plafond-1.jpg',
    images: Array.from({ length: 7 }, (_, i) => `/images/plafond/plafond-${i + 1}.jpg`),
  },
  {
    id: 'kit',
    labelKey: 'portfolio.cat.kit',
    label: 'Fixtures & Fittings',
    cover: '/images/kit/kit-1.jpg',
    images: Array.from({ length: 3 }, (_, i) => `/images/kit/kit-${i + 1}.jpg`),
  },
];
---

<section id="work" class="py-24 lg:py-32 bg-blanc-casse">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Header -->
    <div class="mb-4">
      <h2 class="font-cormorant text-[32px] lg:text-[48px] font-[600] text-navy-night mb-3" data-i18n="portfolio.title">Our work</h2>
      <div class="w-10 h-[3px] bg-rouge-vif mb-5"></div>
      <p class="font-dm-sans text-base font-[300] text-navy-night/70 max-w-xl" data-i18n="portfolio.intro">Every project tells a story. Here are some of ours.</p>
    </div>

    <!-- Category grid -->
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map((cat) => (
        <button
          class="portfolio-card group relative overflow-hidden rounded-lg shadow-sm aspect-[4/3] cursor-pointer focus:outline-none focus:ring-2 focus:ring-rouge-vif focus:ring-offset-2 text-left"
          data-category={cat.id}
          data-label-key={cat.labelKey}
          data-images={JSON.stringify(cat.images)}
          aria-label={`Open ${cat.label} gallery`}
        >
          <!-- Cover image -->
          <img
            src={cat.cover}
            alt={cat.label}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-navy-night/80 via-navy-night/20 to-transparent transition-opacity duration-300 group-hover:from-navy-night/90"></div>

          <!-- Photo count badge (top right) -->
          <div class="absolute top-3 right-3 bg-blanc-casse/20 backdrop-blur-sm text-blanc-casse font-dm-sans text-xs font-[500] px-2.5 py-1 rounded-full border border-blanc-casse/30">
            <span class="lb-count">{cat.images.length}</span>
            &nbsp;<span class="lb-photos-label" data-i18n-count={cat.images.length}>photos</span>
          </div>

          <!-- Category name + view cta (bottom) -->
          <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-between">
            <span class="font-cormorant text-lg lg:text-xl font-[600] text-blanc-casse" data-i18n={cat.labelKey}>{cat.label}</span>
            <span class="font-dm-sans text-xs font-[500] text-blanc-casse/0 group-hover:text-blanc-casse/90 transition-all duration-300 translate-y-2 group-hover:translate-y-0 flex items-center gap-1.5" data-i18n="portfolio.view">
              View gallery
            </span>
          </div>

          <!-- Rouge-vif bottom accent line -->
          <div class="absolute bottom-0 left-0 right-0 h-[3px] bg-rouge-vif scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
        </button>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <p class="font-cormorant text-xl lg:text-2xl italic text-navy-night/70 mb-5" data-i18n="portfolio.cta_text">Have a project in mind? Let's talk.</p>
      <a href="#contact" class="inline-block bg-navy-night text-blanc-casse font-dm-sans text-sm font-[500] px-7 py-3.5 rounded transition-opacity hover:opacity-80" data-i18n="portfolio.cta_btn">Start your project</a>
    </div>

  </div>
</section>

<!-- ── Lightbox ──────────────────────────────────────── -->
<div
  id="lightbox"
  class="fixed inset-0 z-[200] flex flex-col bg-[#4a4a4a] opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Image gallery"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-5 py-4 shrink-0">
    <h3 id="lb-title" class="font-cormorant text-xl font-[600] text-blanc-casse"></h3>
    <div class="flex items-center gap-5">
      <span id="lb-counter" class="font-dm-sans text-sm text-pierre tabular-nums"></span>
      <button
        id="lb-close"
        class="text-pierre hover:text-blanc-casse transition-colors p-1"
        aria-label="Close gallery"
        data-i18n-aria="portfolio.lb.close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Main image area -->
  <div class="relative flex-1 flex items-center justify-center overflow-hidden px-14 pb-4">

    <!-- Prev button -->
    <button
      id="lb-prev"
      class="absolute left-2 lg:left-5 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/20 hover:bg-rouge-vif/90 text-white flex items-center justify-center transition-all duration-200 hover:scale-110 border border-white/30 shadow-md"
      aria-label="Previous image"
      data-i18n-aria="portfolio.lb.prev"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <!-- Image wrapper (for fade transition) -->
    <div id="lb-img-wrap" class="w-full h-full flex items-center justify-center transition-opacity duration-200">
      <img
        id="lb-img"
        src=""
        alt=""
        class="max-h-full max-w-full object-contain rounded-sm select-none"
        draggable="false"
      />
    </div>

    <!-- Next button -->
    <button
      id="lb-next"
      class="absolute right-2 lg:right-5 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/20 hover:bg-rouge-vif/90 text-white flex items-center justify-center transition-all duration-200 hover:scale-110 border border-white/30 shadow-md"
      aria-label="Next image"
      data-i18n-aria="portfolio.lb.next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <!-- Thumbnail strip -->
  <div id="lb-thumbs" class="shrink-0 flex gap-2 px-5 pb-5 overflow-x-auto scrollbar-thin"></div>
</div>

<script>
  // ── Data & state ────────────────────────────────────
  let currentImages: string[] = [];
  let currentIndex = 0;
  let touchStartX = 0;

  const lb        = document.getElementById('lightbox')!;
  const lbTitle   = document.getElementById('lb-title')!;
  const lbCounter = document.getElementById('lb-counter')!;
  const lbClose   = document.getElementById('lb-close')!;
  const lbPrev    = document.getElementById('lb-prev')!;
  const lbNext    = document.getElementById('lb-next')!;
  const lbImgWrap = document.getElementById('lb-img-wrap')!;
  const lbImg     = document.getElementById('lb-img') as HTMLImageElement;
  const lbThumbs  = document.getElementById('lb-thumbs')!;

  // ── Open / close ────────────────────────────────────
  function openLightbox(images: string[], index: number, title: string) {
    currentImages = images;
    lbTitle.textContent = title;
    document.body.style.overflow = 'hidden';
    lb.classList.remove('opacity-0', 'pointer-events-none');
    buildThumbs();
    goTo(index, false);
  }

  function closeLightbox() {
    lb.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
    lbImg.src = '';
  }

  // ── Navigation ───────────────────────────────────────
  function goTo(index: number, animate = true) {
    currentIndex = (index + currentImages.length) % currentImages.length;

    if (animate) {
      lbImgWrap.style.opacity = '0';
      setTimeout(() => {
        setImage();
        lbImgWrap.style.opacity = '1';
      }, 180);
    } else {
      lbImgWrap.style.opacity = '1';
      setImage();
    }

    // Update counter
    lbCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;

    // Update thumbnails
    lbThumbs.querySelectorAll<HTMLElement>('.lb-thumb').forEach((t, i) => {
      t.classList.toggle('ring-2',          i === currentIndex);
      t.classList.toggle('ring-rouge-vif',  i === currentIndex);
      t.classList.toggle('ring-offset-2',   i === currentIndex);
      t.classList.toggle('ring-offset-black', i === currentIndex);
      t.classList.toggle('opacity-50',      i !== currentIndex);
      t.classList.toggle('opacity-100',     i === currentIndex);
    });

    // Scroll active thumb into view
    const activeThumb = lbThumbs.children[currentIndex] as HTMLElement;
    activeThumb?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  }

  function setImage() {
    lbImg.src = currentImages[currentIndex];
    lbImg.alt = `Photo ${currentIndex + 1} of ${currentImages.length}`;
  }

  // ── Thumbnails ───────────────────────────────────────
  function buildThumbs() {
    lbThumbs.innerHTML = '';
    currentImages.forEach((src, i) => {
      const btn = document.createElement('button');
      btn.className = 'lb-thumb shrink-0 w-14 h-14 rounded overflow-hidden transition-all duration-200 opacity-50';
      btn.setAttribute('aria-label', `Go to photo ${i + 1}`);
      const img = document.createElement('img');
      img.src = src;
      img.className = 'w-full h-full object-cover';
      img.loading = 'lazy';
      btn.appendChild(img);
      btn.addEventListener('click', () => goTo(i));
      lbThumbs.appendChild(btn);
    });
  }

  // ── Card click handlers ──────────────────────────────
  document.querySelectorAll<HTMLElement>('.portfolio-card').forEach(card => {
    card.addEventListener('click', () => {
      const images = JSON.parse(card.dataset.images || '[]') as string[];
      const labelEl = card.querySelector<HTMLElement>('[data-i18n]');
      const title = labelEl?.textContent?.trim() || card.dataset.category || '';
      openLightbox(images, 0, title);
    });
  });

  // ── Controls ─────────────────────────────────────────
  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click',  () => goTo(currentIndex - 1));
  lbNext.addEventListener('click',  () => goTo(currentIndex + 1));

  // Backdrop click to close
  lb.addEventListener('click', (e) => {
    if (e.target === lb || e.target === lbImgWrap) closeLightbox();
  });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (lb.classList.contains('pointer-events-none')) return;
    if (e.key === 'Escape')     closeLightbox();
    if (e.key === 'ArrowLeft')  goTo(currentIndex - 1);
    if (e.key === 'ArrowRight') goTo(currentIndex + 1);
  });

  // Touch / swipe
  lbImgWrap.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lbImgWrap.addEventListener('touchend',   (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) goTo(currentIndex + (dx < 0 ? 1 : -1));
  });

  // ── Keep lightbox title in sync with i18n ────────────
  // Re-read the active card's translated label whenever language changes
  window.addEventListener('storage', (e) => {
    if (e.key !== 'lang') return;
    if (!lb.classList.contains('pointer-events-none')) {
      // find the open card's translated label
      const openCard = document.querySelector<HTMLElement>(
        `.portfolio-card[data-images='${JSON.stringify(currentImages)}']`
      );
      const labelEl = openCard?.querySelector<HTMLElement>('[data-i18n]');
      if (labelEl) lbTitle.textContent = labelEl.textContent?.trim() || '';
    }
  });

  // Also hook into i18n apply by dispatching a custom event we can listen to
  document.addEventListener('i18n:applied', () => {
    if (!lb.classList.contains('pointer-events-none')) {
      const openCard = Array.from(document.querySelectorAll<HTMLElement>('.portfolio-card')).find(
        card => card.dataset.images === JSON.stringify(currentImages)
      );
      const labelEl = openCard?.querySelector<HTMLElement>('[data-i18n]');
      if (labelEl) lbTitle.textContent = labelEl.textContent?.trim() || '';
    }

    // Update photo count labels in cards
    document.querySelectorAll<HTMLElement>('.lb-photos-label').forEach(el => {
      const n = parseInt(el.dataset.i18nCount || '0');
      const lang = (localStorage.getItem('lang') || 'en') as 'en' | 'fi' | 'fr';
      const templates: Record<string, string> = { en: 'photos', fi: 'kuvaa', fr: 'photos' };
      el.textContent = templates[lang] || 'photos';
    });
  });
</script>

<style>
  #lightbox { will-change: opacity; }
  #lb-thumbs::-webkit-scrollbar { height: 4px; }
  #lb-thumbs::-webkit-scrollbar-thumb { background: #1C3A6E; border-radius: 2px; }
  .ring-rouge-vif { --tw-ring-color: #B8001E; }
</style>
