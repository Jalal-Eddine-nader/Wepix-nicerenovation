---
const services = [
  {
    key: '1',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    title: 'Full Home Renovation',
    desc:  "Complete transformations from structure to finishings. We manage the entire project so you don't have to.",
  },
  {
    key: '2',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3h-3a2 2 0 0 0-2 2v2h7V5a2 2 0 0 0-2-2z"/><path d="M6 7V5"/><path d="M8 7V4"/></svg>`,
    title: 'Kitchen Renovation',
    desc:  "Functional, beautiful kitchens designed around how you actually live. Custom cabinetry, worktops, and full fit-out.",
  },
  {
    key: '3',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" y1="5" x2="8" y2="7"/><line x1="2" y1="12" x2="22" y2="12"/></svg>`,
    title: 'Bathroom Renovation',
    desc:  "Elegant wet rooms and bathrooms built to last. Waterproofing, tiling, fixtures — done properly, every time.",
  },
  {
    key: '4',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="18" width="20" height="3" rx="1"/><path d="M4 18V7"/><path d="M20 18V7"/><path d="M4 10h16"/></svg>`,
    title: 'Flooring & Finishing',
    desc:  "Parquet, tiles, vinyl, and hardwood. Precision installation and meticulous finishing that defines a room.",
  },
  {
    key: '5',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
    title: 'Painting & Plastering',
    desc:  "Smooth surfaces, crisp lines, flawless colour. Interior and exterior work to professional French standards.",
  },
  {
    key: '6',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>`,
    title: 'Commercial Renovation',
    desc:  "Offices, retail spaces, and hospitality fit-outs. Minimal disruption, maximum impact on your space.",
  },
];
---

<section id="services" class="py-24 lg:py-32 bg-blanc-casse">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-16">
      <h2 class="font-cormorant text-[32px] lg:text-[48px] font-[600] text-navy-night mb-3" data-i18n="services.title">What we do</h2>
      <div class="w-10 h-[3px] bg-rouge-vif"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => (
        <article class="bg-white border border-pierre rounded-lg p-7 flex flex-col gap-4 transition-colors duration-200 hover:border-bleu-royal group">
          <div class="text-bleu-royal group-hover:text-rouge-vif transition-colors duration-200" set:html={s.icon} />
          <h3 class="font-cormorant text-xl font-[600] text-navy-night" data-i18n={`services.${s.key}.title`}>{s.title}</h3>
          <p class="font-dm-sans text-sm font-[300] text-navy-night/70 leading-relaxed" data-i18n={`services.${s.key}.desc`}>{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
