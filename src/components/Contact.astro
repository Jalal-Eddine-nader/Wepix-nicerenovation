---
---

<section id="contact" class="py-24 lg:py-32 bg-blanc-casse">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-14">
      <h2 class="font-cormorant text-[32px] lg:text-[48px] font-[600] text-navy-night mb-3" data-i18n="contact.title">Let's talk about your project</h2>
      <div class="w-10 h-[3px] bg-rouge-vif"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-14 items-start">

      <!-- WhatsApp CTA -->
      <div class="lg:col-span-3 flex flex-col">
        <p class="font-dm-sans text-base font-[300] text-navy-night/70 mb-10 max-w-md leading-relaxed" data-i18n="contact.wa_intro">
          The quickest way to reach us is on WhatsApp. Tap the button and we'll get back to you within 24 hours with a free, no-obligation quote.
        </p>

        <a
          id="whatsapp-cta"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#25D366] text-white font-dm-sans text-sm font-[500] px-8 py-4 rounded-lg transition-all hover:opacity-90 hover:shadow-lg w-fit shadow-md"
        >
          <!-- WhatsApp icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span data-i18n="contact.whatsapp_btn">Message us on WhatsApp</span>
        </a>

        <p class="font-dm-sans text-xs text-navy-night/40 mt-4" data-i18n="contact.wa_note">
          Free, no-obligation quote. We reply within 24 hours.
        </p>
      </div>

      <!-- Contact info -->
      <div class="lg:col-span-2 space-y-6">
        <div>
          <p class="font-dm-sans text-xs font-[500] tracking-[0.15em] uppercase text-navy-night/40 mb-2" data-i18n="contact.info_phone">Phone</p>
          <a href="tel:+358408143298" class="font-cormorant text-xl text-navy-night hover:text-rouge-vif transition-colors">+358 40 814 3298</a>
        </div>

        <div>
          <p class="font-dm-sans text-xs font-[500] tracking-[0.15em] uppercase text-navy-night/40 mb-2" data-i18n="contact.info_address_label">Address</p>
          <p class="font-cormorant text-xl text-navy-night leading-snug">
            Hallituskatu 7<br />Tampere, Finland
          </p>
        </div>

        <div>
          <p class="font-dm-sans text-xs font-[500] tracking-[0.15em] uppercase text-navy-night/40 mb-2" data-i18n="contact.info_area_label">Service area</p>
          <p class="font-dm-sans text-sm font-[300] text-navy-night/70 leading-relaxed">
            <span data-i18n="contact.info_area">Tampere region, Finland</span><br />
            <span class="text-navy-night/40" data-i18n="contact.info_area_sub">Pirkanmaa and surroundings</span>
          </p>
        </div>

        <div>
          <p class="font-dm-sans text-xs font-[500] tracking-[0.15em] uppercase text-navy-night/40 mb-2" data-i18n="contact.info_resp_label">Response time</p>
          <p class="font-dm-sans text-sm font-[300] text-navy-night/70" data-i18n="contact.info_resp">We reply within 24 hours.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const WA_NUMBER = '358408143298';
  const WA_MESSAGES: Record<string, string> = {
    en: 'Hello, can I get a free quote?',
    fi: 'Hei, voisinko saada ilmaisen tarjouksen?',
    fr: 'Bonjour, puis-je obtenir un devis gratuit ?',
  };

  function updateWaLink(lang: string) {
    const msg = WA_MESSAGES[lang] ?? WA_MESSAGES['en'];
    const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`;
    const btn = document.getElementById('whatsapp-cta') as HTMLAnchorElement | null;
    if (btn) btn.href = url;
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateWaLink(localStorage.getItem('lang') || 'en');
  });

  document.addEventListener('i18n:applied', (e: Event) => {
    const lang = (e as CustomEvent<{ lang: string }>).detail?.lang ?? localStorage.getItem('lang') ?? 'en';
    updateWaLink(lang);
  });
</script>
