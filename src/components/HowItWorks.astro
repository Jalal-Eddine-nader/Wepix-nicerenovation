---
const steps = [
  { num: '01', key: '1', title: 'Free consultation',  desc: 'We come to you. A no-obligation visit to understand your vision, assess the space, and discuss possibilities.' },
  { num: '02', key: '2', title: 'Custom quote',       desc: 'Within a few days you receive a detailed, transparent quote. Itemised costs, realistic timelines, no surprises.' },
  { num: '03', key: '3', title: 'We build',           desc: 'Our team gets to work. We keep you informed at every stage and document progress with photos along the way.' },
  { num: '04', key: '4', title: 'You enjoy',          desc: 'We do a final walkthrough together. Only when you are completely satisfied do we consider the project finished.' },
];
---

<section id="process" class="py-24 lg:py-32 bg-navy-night">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-16 text-center">
      <h2 class="font-cormorant text-[32px] lg:text-[48px] font-[600] text-blanc-casse mb-3" data-i18n="process.title">How it works</h2>
      <div class="w-10 h-[3px] bg-rouge-vif mx-auto"></div>
    </div>

    <div class="relative flex flex-col lg:flex-row gap-10 lg:gap-0">
      <div class="hidden lg:block absolute top-8 left-[12.5%] right-[12.5%] h-[1px] bg-bleu-royal" aria-hidden="true"></div>

      {steps.map((step) => (
        <div class="flex-1 flex flex-col items-center text-center px-6 relative">
          <div class="relative z-10 w-16 h-16 rounded-full border-2 border-bleu-royal bg-navy-night flex items-center justify-center mb-6">
            <span class="font-cormorant text-2xl font-[600] text-rouge-vif">{step.num}</span>
          </div>
          <h3 class="font-cormorant text-xl lg:text-2xl font-[600] text-blanc-casse mb-3" data-i18n={`process.${step.key}.title`}>{step.title}</h3>
          <p class="font-dm-sans text-sm font-[300] text-pierre leading-relaxed max-w-xs" data-i18n={`process.${step.key}.desc`}>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
